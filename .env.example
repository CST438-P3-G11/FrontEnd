# Copy to `.env` and fill in real values. `.env` is gitignored.
# Anything prefixed EXPO_PUBLIC_ is exposed to the JS bundle at runtime.

# Backend base URL (no trailing slash)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Public OAuth client IDs (NOT secrets)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Optional: only needed for native Android builds (eas build / expo run:android).
# Leave blank if you only run on web or Expo Go.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GITHUB_CLIENT_ID=
